# dnslog.org 分配的完整根域名（不要包含 listener-req）
P2D_DOMAIN=replace-with-your-root-domain.example

# 隔离网内允许查询的递归 DNS 服务器；必须写 IP，可选端口
P2D_DNS_SERVER=10.0.0.53:53

# 与服务端 P2D_XOR_KEY 完全相同，至少 8 个 UTF-8 字节
P2D_XOR_KEY=replace-with-a-long-random-secret

# 与服务端 P2D_AUTH_KEY 完全相同，至少 32 个 UTF-8 字节
P2D_AUTH_KEY=replace-with-a-different-32-byte-authentication-key

# 在同一地址上一次监听多个 TCP 端口
P2D_BIND_ADDRESS=0.0.0.0
P2D_PORTS=139,445,1080,1099

# 以下项目通常保持默认值即可
P2D_MARKER=listener-req
P2D_QUEUE_SIZE=256
P2D_WORKERS=2
P2D_RETRIES=3
P2D_QUERY_TIMEOUT=3s

# 默认 false，不产生任何应用日志；仅在排错时临时改为 true
P2D_VERBOSE=false
