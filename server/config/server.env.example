# dnslog.org API 与根域名
P2D_DNSLOG_TOKEN=replace-with-your-dnslog-token
P2D_DOMAIN=replace-with-your-root-domain.example

# 必须与客户端完全相同
P2D_XOR_KEY=replace-with-a-long-random-secret
P2D_AUTH_KEY=replace-with-a-different-32-byte-authentication-key

# Telegram
P2D_TELEGRAM_BOT_TOKEN=123456789:replace-with-telegram-bot-token
P2D_TELEGRAM_CHAT_ID=-1001234567890

# 以下项目通常保持默认值即可
P2D_DB_PATH=events.db
P2D_MARKER=listener-req
P2D_POLL_INTERVAL=10
P2D_REQUEST_TIMEOUT=10
P2D_PENDING_BATCH=100
P2D_DNSLOG_URL=https://dnslog.org/{token}
P2D_TELEGRAM_API_BASE=https://api.telegram.org
P2D_TELEGRAM_DISABLE_NOTIFICATION=false
P2D_RUN_ONCE=false
P2D_CHECK_CONFIG=false
P2D_VERBOSE=false
